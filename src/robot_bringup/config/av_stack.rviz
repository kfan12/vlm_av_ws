Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /lane_path_odom1
        - /plan_path_odom1
      Splitter Ratio: 0.5
    Tree Height: 640
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Image
      Name: lane/debug_image
      Enabled: true
      Topic:
        Value: /lane/debug_image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Median window: 5
      Normalize Range: true
    - Class: rviz_default_plugins/MarkerArray
      Name: lane/debug_markers
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /lane/debug_markers
        Depth: 200
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: lane_path_odom
      Enabled: true
      Topic:
        Value: /lane/path_odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 170; 0; 0
      Alpha: 0.7
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.5
      Head Diameter: 0
      Head Length: 0
      Shaft Diameter: 0
      Shaft Length: 0
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/Path
      Name: plan_path_odom
      Enabled: true
      Topic:
        Value: /plan/path_odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 200; 255
      Alpha: 0.5
      Buffer Length: 1
      Line Style: Billboards
      Line Width: 0.2
      Head Diameter: 0
      Head Length: 0
      Shaft Diameter: 0
      Shaft Length: 0
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/Path
      Name: reference_path_odom
      Enabled: true
      Topic:
        Value: /mpc_reference_path
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Alpha: 1
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.5
      Head Diameter: 0
      Head Length: 0
      Shaft Diameter: 0
      Shaft Length: 0
      Pose Style: None
      Offset:
        X: 0
        Y: 0
        Z: 0
    - Class: rviz_default_plugins/Odometry
      Name: odom_ekf
      Enabled: true
      Topic:
        Value: /odom_ekf
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Shaft Length: 1
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 100
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Odometry
      Name: odom_truth
      Enabled: true
      Topic:
        Value: /odom_truth
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 0; 255; 0
      Alpha: 1
      Shaft Length: 1
      Shaft Radius: 0.05
      Head Length: 0.3
      Head Radius: 0.1
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 100
      Covariance:
        Value: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 3.14
      Target Frame: base_link
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: false
  Views:
    collapsed: false
